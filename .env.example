# Copy to .env for local development. Never commit .env.
BIDTRIAGE_ENV=dev
DATABASE_URL=postgresql+psycopg://bidtriage:bidtriage@localhost:5432/bidtriage
# Blob storage (SPEC-01): local disk by default; set BLOB_BUCKET for S3-compatible storage
BLOB_DIR=./var/blobs
# BLOB_BUCKET=bidtriage-attachments
# BLOB_ENDPOINT_URL=https://s3.us-east-2.amazonaws.com
# BLOB_PREFIX=prod
SECRET_KEY=change-me-32-bytes-minimum-please-change
BASE_URL=http://localhost:8000

# LLM extraction (ADR-004)
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=medium
LLM_DAILY_SPEND_CAP_USD=25

# Digest (SPEC-05)
DIGEST_TIME=06:30
DIGEST_TIMEZONE=America/New_York
DIGEST_FROM=bids@ferryelectric.com
SMTP_URL=smtp://localhost:1025

# Home base for distance factor (SPEC-07)
HOME_ADDRESS=250 Curry Hollow Road, Pittsburgh, PA 15236
HOME_LAT=40.3462
HOME_LON=-79.9482

# Ingestion (SPEC-01)
INGEST_BACKFILL_DAYS=90
INGEST_BACKFILL_BATCH=50
INGEST_LIVE_BATCH=200
# OCR needs the `ocr` extra plus the tesseract and poppler binaries
INGEST_OCR=false
# Where "mail source down" alerts go; defaults to the admin and chief users
ADMIN_ALERT_TO=

# Microsoft Graph source (ADR-003) - register with `bidtriage add-source graph ...`
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=estimating@ferryelectric.com
