{% macro card(it, now, role) %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #d9d9d9;border-left:5px solid {% if it.band=='bid' %}#1a7f37{% elif it.band=='consider' %}#b26a00{% else %}#888888{% endif %};margin:0 0 12px 0;font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#222;">
<tr><td style="padding:10px 12px;">
  <div style="font-size:16px;font-weight:bold;">
    <span style="display:inline-block;min-width:34px;padding:1px 6px;background:#f1f1f1;border-radius:3px;font-size:13px;">{{ it.score }} · {{ it.band|band_label }}</span>
    {% if it.is_new %}<span style="font-size:11px;color:#1a7f37;">NEW</span>{% endif %}
    <a href="{{ it.open_url }}" style="color:#0b3d91;text-decoration:none;" title="{{ it.project_name }}">{{ it.project_name|truncate90 }}</a>
    <span style="font-weight:normal;color:#555;">({{ it.project_type|humanize|title }}{% if it.new_or_renovation != 'unknown' %} · {{ it.new_or_renovation|humanize|title }}{% endif %})</span>
  </div>
  <div style="margin-top:4px;">GC: <b>{{ it.gc_name or 'Unknown' }}</b>{% if it.gc_tier != 'unknown' %} (Tier {{ it.gc_tier }}){% endif %}{% if it.location_short %} · {{ it.location_short }}{% endif %}{% if it.distance_miles is not none %}, {{ it.distance_miles|round|int }} mi{% endif %} · {{ it.size_reason }}</div>
  <div style="margin-top:2px;">
    Due: <b>{% if it.bid_due %}{{ it.bid_due|fmt_dt(now, it.bid_due_time_known) }} ({{ it.bid_due|days_left(now) }}){% else %}<span style="color:#b00020;">Due date unknown</span>{% endif %}</b>
    {% if it.prebid_at %} · Pre-bid: {{ it.prebid_at|fmt_dt(now) }}{% if it.prebid_mandatory %} <b>(mandatory)</b>{% endif %}{% endif %}
    {% if it.rfi_deadline %} · RFIs due {{ it.rfi_deadline|fmt_dt(now, false) }}{% endif %}
  </div>
  <div style="margin-top:4px;color:#333;">Scope: {{ it.summary }}{% if it.exclusions %} <i>Excludes: {{ it.exclusions }}</i>{% endif %}</div>
  <div style="margin-top:2px;color:#555;">Addenda: {{ it.addenda_count }}{% if it.addendum_gap %} <span style="color:#b00020;">({% if it.missing_addenda %}Addend{{ 'a' if it.missing_addenda|length > 1 else 'um' }} {{ it.missing_addenda|join(', ') }} not received{% else %}gap: one or more not received{% endif %})</span>{% endif %}{% if it.docs_host %} · Docs: {{ it.docs_host|humanize }}{% endif %}
    {% for f in it.flags %}<span style="display:inline-block;margin-left:4px;padding:0 5px;border:1px solid #bbb;border-radius:8px;font-size:11px;">{{ f|humanize }}</span>{% endfor %}
  </div>
  {% if it.change_summary %}<div style="margin-top:4px;color:#8a4b00;"><b>Changed:</b> {{ it.change_summary }}</div>{% endif %}
  <div style="margin-top:4px;color:#444;">Why: {{ it.why_positive|join(' (+), ') }}{% if it.why_positive %} (+){% endif %}{% if it.why_negative %}; {{ it.why_negative|join(' (−), ') }} (−){% endif %}</div>
  {% if role != 'readonly' and it.actions %}
  <div style="margin-top:8px;">
    {% for label, url in it.actions.items() %}<a href="{{ url }}" style="display:inline-block;padding:5px 10px;margin-right:6px;border:1px solid #0b3d91;border-radius:3px;color:#0b3d91;text-decoration:none;font-size:13px;">{{ label }}</a>{% endfor %}
  </div>
  {% endif %}
</td></tr></table>
{% endmacro %}
